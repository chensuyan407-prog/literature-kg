<edge id="R:21f9429969" source="paper-B:Measurement:residual-mass-at-1000-c-ha-59-21-ha-rgo" target="paper-B:Conclusion:rgo-incorporation-improves-thermal-stabi"><data key="e_predicate">SUPPORTS</data><data key="e_source_id">paper-B</data><data key="e_strength">direct</data><data key="e_conditions">{}</data><data key="e_paragraph_id">p-0061</data><data key="e_quote">as confirmed by lower mass losses at the main decomposition stages and an increase in residual mass at 1000 °C from 59.21 to 70.03%</data></edge>
<edge id="R:a298178a6f" source="paper-B:Sample:humic-acid-reduced-graphene-oxide-compos" target="C:Material:phenol"><data key="e_predicate">TESTED_ON</data><data key="e_source_id">paper-B</data><data key="e_strength">direct</data><data key="e_conditions">{}</data><data key="e_paragraph_id">p-0028</data><data key="e_quote">Phenol adsorption was evaluated as a preliminary functional test of the synthesized HA-rGO composite.</data></edge>
