{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "literature-kg extraction file (one per paper, or several part files)",
 "type": "object",
 "required": [
  "source_id",
  "entities",
  "relations"
 ],
 "properties": {
  "source_id": {
   "type": "string"
  },
  "entities": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "key",
     "name",
     "type",
     "mentions"
    ],
    "properties": {
     "key": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "type": {
      "enum": [
       "Conclusion",
       "Condition",
       "Dataset",
       "Instrument",
       "Material",
       "Measurement",
       "Mechanism",
       "Method",
       "Metric",
       "Model",
       "Paper",
       "Researcher",
       "Sample",
       "Task"
      ]
     },
     "aliases": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "attributes": {
      "type": "object"
     },
     "definition": {
      "type": [
       "string",
       "null"
      ]
     },
     "attribution": {
      "enum": [
       "author",
       "cited"
      ]
     },
     "mentions": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "paragraph_id",
        "quote"
       ],
       "properties": {
        "paragraph_id": {
         "type": "string"
        },
        "quote": {
         "type": "string",
         "minLength": 12,
         "maxLength": 300
        }
       }
      }
     }
    }
   }
  },
  "relations": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "subject",
     "predicate",
     "object"
    ],
    "properties": {
     "subject": {
      "type": "string",
      "description": "entity key, name or alias of the same paper; 'paper' = the paper itself"
     },
     "predicate": {
      "enum": [
       "APPLIED_TO",
       "ATTRIBUTED_TO",
       "AUTHOR_OF",
       "CHARACTERIZED_BY",
       "COMPARED_WITH",
       "CONCLUDES",
       "CONTRADICTS",
       "FITS",
       "HAS_RESULT",
       "INSTANCE_OF",
       "INVOLVES",
       "MEASURED_BY",
       "OUTPERFORMS",
       "PART_OF",
       "PREPARED_FROM",
       "STUDIES",
       "SUPPORTS",
       "TESTED_ON",
       "UNDER_CONDITION",
       "USES"
      ]
     },
     "object": {
      "type": "string"
     },
     "conditions": {
      "type": "object"
     },
     "paragraph_id": {
      "type": "string"
     },
     "quote": {
      "type": "string"
     },
     "evidence": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "paragraph_id",
        "quote"
       ],
       "properties": {
        "paragraph_id": {
         "type": "string"
        },
        "quote": {
         "type": "string",
         "minLength": 12,
         "maxLength": 300
        }
       }
      }
     },
     "strength": {
      "enum": [
       "direct",
       "indirect",
       "hedged",
       "cited"
      ]
     },
     "attribution": {
      "enum": [
       "author",
       "cited"
      ]
     },
     "polarity": {
      "enum": [
       "positive",
       "negative"
      ]
     },
     "note": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   }
  },
  "not_reported": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "item": {
      "type": "string"
     },
     "note": {
      "type": "string"
     }
    }
   }
  }
 },
 "x-predicate-constraints": {
  "AUTHOR_OF": {
   "subject_types": [
    "Researcher"
   ],
   "object_types": [
    "Paper"
   ],
   "meaning": "researcher wrote the paper (manifest/byline evidence)"
  },
  "STUDIES": {
   "subject_types": [
    "Method",
    "Model",
    "Paper",
    "Sample"
   ],
   "object_types": [
    "Material",
    "Task"
   ],
   "meaning": "work addresses a task / studies a material"
  },
  "USES": {
   "subject_types": [
    "Measurement",
    "Method",
    "Model",
    "Paper",
    "Sample",
    "Task"
   ],
   "object_types": [
    "Dataset",
    "Instrument",
    "Material",
    "Method",
    "Metric",
    "Model"
   ],
   "meaning": "uses a method, material, dataset, instrument"
  },
  "PREPARED_FROM": {
   "subject_types": [
    "Material",
    "Sample"
   ],
   "object_types": [
    "Material",
    "Sample"
   ],
   "meaning": "made from / modified with"
  },
  "INSTANCE_OF": {
   "subject_types": [
    "Dataset",
    "Model",
    "Sample"
   ],
   "object_types": [
    "Dataset",
    "Material",
    "Method"
   ],
   "meaning": "paper-specific instance of a general concept"
  },
  "CHARACTERIZED_BY": {
   "subject_types": [
    "Material",
    "Model",
    "Sample"
   ],
   "object_types": [
    "Instrument",
    "Method"
   ],
   "meaning": "characterised / analysed with"
  },
  "HAS_RESULT": {
   "subject_types": [
    "Material",
    "Method",
    "Model",
    "Paper",
    "Sample"
   ],
   "object_types": [
    "Measurement"
   ],
   "meaning": "reported value / observation for the subject"
  },
  "MEASURED_BY": {
   "subject_types": [
    "Measurement"
   ],
   "object_types": [
    "Instrument",
    "Method",
    "Metric"
   ],
   "meaning": "what quantity / method the value is"
  },
  "UNDER_CONDITION": {
   "subject_types": [
    "Conclusion",
    "Measurement",
    "Sample"
   ],
   "object_types": [
    "Condition"
   ],
   "meaning": "value or claim holds under this condition"
  },
  "FITS": {
   "subject_types": [
    "Method",
    "Model"
   ],
   "object_types": [
    "Measurement",
    "Sample"
   ],
   "meaning": "model describes the data (e.g. isotherm/kinetic model fits)"
  },
  "OUTPERFORMS": {
   "subject_types": [
    "Conclusion",
    "Condition",
    "Dataset",
    "Instrument",
    "Material",
    "Measurement",
    "Mechanism",
    "Method",
    "Metric",
    "Model",
    "Sample",
    "Task"
   ],
   "object_types": [
    "Conclusion",
    "Condition",
    "Dataset",
    "Instrument",
    "Material",
    "Measurement",
    "Mechanism",
    "Method",
    "Metric",
    "Model",
    "Sample",
    "Task"
   ],
   "meaning": "subject better than object on a stated criterion"
  },
  "COMPARED_WITH": {
   "subject_types": [
    "Conclusion",
    "Condition",
    "Dataset",
    "Instrument",
    "Material",
    "Measurement",
    "Mechanism",
    "Method",
    "Metric",
    "Model",
    "Paper",
    "Sample",
    "Task"
   ],
   "object_types": [
    "Conclusion",
    "Condition",
    "Dataset",
    "Instrument",
    "Material",
    "Measurement",
    "Mechanism",
    "Method",
    "Metric",
    "Model",
    "Paper",
    "Sample",
    "Task"
   ],
   "meaning": "explicit comparison without a winner"
  },
  "SUPPORTS": {
   "subject_types": [
    "Conclusion",
    "Measurement",
    "Method",
    "Sample"
   ],
   "object_types": [
    "Conclusion"
   ],
   "meaning": "evidence supports the claim"
  },
  "CONTRADICTS": {
   "subject_types": [
    "Conclusion",
    "Measurement"
   ],
   "object_types": [
    "Conclusion",
    "Measurement"
   ],
   "meaning": "evidence contradicts the claim"
  },
  "CONCLUDES": {
   "subject_types": [
    "Paper"
   ],
   "object_types": [
    "Conclusion"
   ],
   "meaning": "paper states this conclusion"
  },
  "PART_OF": {
   "subject_types": [
    "Conclusion",
    "Condition",
    "Dataset",
    "Instrument",
    "Material",
    "Measurement",
    "Mechanism",
    "Method",
    "Metric",
    "Model",
    "Paper",
    "Researcher",
    "Sample",
    "Task"
   ],
   "object_types": [
    "Conclusion",
    "Condition",
    "Dataset",
    "Instrument",
    "Material",
    "Measurement",
    "Mechanism",
    "Method",
    "Metric",
    "Model",
    "Paper",
    "Researcher",
    "Sample",
    "Task"
   ],
   "meaning": "component / sub-step of"
  },
  "TESTED_ON": {
   "subject_types": [
    "Material",
    "Method",
    "Model",
    "Sample"
   ],
   "object_types": [
    "Dataset",
    "Material",
    "Sample",
    "Task"
   ],
   "meaning": "adsorbent/method tested with a target substance, dataset or task"
  },
  "ATTRIBUTED_TO": {
   "subject_types": [
    "Conclusion",
    "Measurement",
    "Sample"
   ],
   "object_types": [
    "Conclusion",
    "Material",
    "Mechanism",
    "Metric"
   ],
   "meaning": "authors explain the result by this mechanism / cause"
  },
  "INVOLVES": {
   "subject_types": [
    "Conclusion",
    "Material",
    "Method",
    "Sample"
   ],
   "object_types": [
    "Mechanism"
   ],
   "meaning": "process or interaction involves this mechanism"
  },
  "APPLIED_TO": {
   "subject_types": [
    "Material",
    "Method",
    "Model",
    "Sample"
   ],
   "object_types": [
    "Dataset",
    "Material",
    "Sample",
    "Task"
   ],
   "meaning": "applied to a target / task"
  }
 }
}